diff --git a/kernel/trap.c b/kernel/trap.c
index 00e99bc..34386c5 100644
--- a/kernel/trap.c
+++ b/kernel/trap.c
@@ -71,7 +71,27 @@ usertrap(void)
   } else if ((r_scause() == 15 || r_scause() == 13) &&
              vmfault(p->pagetable, p->sz, r_stval(),
                      (r_scause() == 13) ? 1 : 0) != 0) {
+    p->page_fault_count++;   // A9-Q2: count handled fault
     // page fault on lazily-allocated page
+  } else if(r_scause() == 13 || r_scause() == 15){
+    // A9-Q2: lazy-allocation page fault
+    uint64 va = r_stval();
+    if(va < p->sz){
+      char *mem = kalloc();
+      if(mem == 0){
+        p->killed = 1;
+      } else {
+        memset(mem, 0, PGSIZE);
+        if(mappages(p->pagetable, PGROUNDDOWN(va), PGSIZE, (uint64)mem, PTE_R|PTE_W|PTE_U) < 0){
+          kfree(mem);
+          p->killed = 1;
+        } else {
+        }
+      }
+    } else {
+      printk("pid %d: fault at 0x%lx (sz=0x%lx), killed\n", p->pid, va, p->sz);
+      p->killed = 1;
+    }
   } else {
     printk("usertrap(): unexpected scause 0x%lx pid=%d\n", r_scause(), p->pid);
     printk("            sepc=0x%lx stval=0x%lx\n", r_sepc(), r_stval());
